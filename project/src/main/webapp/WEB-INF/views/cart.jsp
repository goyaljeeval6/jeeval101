<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Your cart | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="container page"><p class="eyebrow">YOUR PICKS</p><h1>Your cart.</h1><c:choose><c:when test="${empty items}"><div class="empty"><h2>Your cart is waiting for something good.</h2><a class="button" href="${pageContext.request.contextPath}/products">Browse products</a></div></c:when><c:otherwise><div class="cart-list"><c:forEach var="item" items="${items}"><div class="cart-row"><img src="${item.imageUrl}" alt=""><div class="cart-name"><strong>${item.name}</strong><span>Quantity: ${item.quantity}</span></div><strong>₹${item.lineTotal}</strong></div></c:forEach></div><a class="button" href="${pageContext.request.contextPath}/checkout">Continue to checkout</a></c:otherwise></c:choose></main><%@ include file="fragments/footer.jsp" %></body></html>
