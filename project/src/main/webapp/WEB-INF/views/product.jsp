<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>${product.name} | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="container page"><div class="detail"><img src="${product.imageUrl}" alt="${product.name}"><div><p class="eyebrow">${product.brand}</p><h1>${product.name}</h1><p class="price big">₹${product.salePrice}</p><p class="muted">${product.description}</p><p>${product.stock} available</p><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="productId" value="${product.productId}"><label>Quantity <input type="number" name="quantity" value="1" min="1" max="20"></label><button class="button">Add to cart</button></form></div></div></main><%@ include file="fragments/footer.jsp" %></body></html>
