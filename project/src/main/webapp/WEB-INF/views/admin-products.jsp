<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Admin products | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="container page"><p class="eyebrow">ADMIN WORKSPACE</p><h1>Product management.</h1><c:if test="${not empty error}"><div class="alert error">${error}</div></c:if><div class="admin-layout"><form class="auth-card" method="post" action="${pageContext.request.contextPath}/admin/products"><h2>Add a product</h2><label>Category ID<input type="number" name="categoryId" value="1" min="1" required></label><label>Product name<input name="name" required></label><label>Brand<input name="brand"></label><label>Description<textarea name="description"></textarea></label><label>Price<input type="number" name="price" min="0.01" step=".01" required></label><label>Discount (%)<input type="number" name="discount" min="0" max="100" step=".01" value="0" required></label><label>Stock<input type="number" name="stock" min="0" value="0" required></label><label>Image URL<input name="imageUrl"></label><button class="button full">Add product</button></form><div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td>${p.name}</td><td>₹${p.price}</td><td>${p.stock}</td><td><form method="post" action="${pageContext.request.contextPath}/admin/products"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${p.productId}"><button class="linkbtn danger">Deactivate</button></form></td></tr></c:forEach></tbody></table></div></div><p class="muted">Promote your own registered account to ADMIN in MySQL before opening this page.</p></main><%@ include file="fragments/footer.jsp" %></body></html>
