<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Orders | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="container page"><p class="eyebrow">YOUR SHOPPING</p><h1>Order history.</h1><c:if test="${not empty param.placed}"><div class="alert">Order #${param.placed} placed successfully!</div></c:if><c:choose><c:when test="${empty orders}"><div class="empty"><p>You haven't placed an order yet.</p><a class="button" href="${pageContext.request.contextPath}/products">Explore products</a></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody><c:forEach var="o" items="${orders}"><tr><td>#${o.id}</td><td>${o.created}</td><td>₹${o.total}</td><td>${o.payment}</td><td><span class="pill">${o.status}</span></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main><%@ include file="fragments/footer.jsp" %></body></html>
