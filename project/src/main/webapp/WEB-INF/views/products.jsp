<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><title>Shop products | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %>
<main class="container page"><p class="eyebrow">THE SHOP</p><h1>Find your next favorite.</h1><p class="muted">Good design, useful details, everyday essentials.</p>
<div class="product-grid"><c:forEach var="p" items="${products}"><article class="product-card"><a href="${pageContext.request.contextPath}/product?id=${p.productId}" class="product-image"><img src="${p.imageUrl}" alt="${p.name}" onerror="this.src='https://placehold.co/600x700?text=ShopSphere'"><c:if test="${p.discount gt 0}"><span class="sale">-${p.discount}%</span></c:if></a><div class="product-info"><small>${p.brand}</small><h3><a href="${pageContext.request.contextPath}/product?id=${p.productId}">${p.name}</a></h3><div class="price">₹${p.salePrice}<c:if test="${p.discount gt 0}"><del>₹${p.price}</del></c:if></div><span class="stock">${p.stock gt 0 ? 'In stock' : 'Out of stock'}</span><form action="${pageContext.request.contextPath}/cart" method="post"><input type="hidden" name="productId" value="${p.productId}"><input type="hidden" name="quantity" value="1"><button class="button button-dark" ${p.stock le 0 ? 'disabled' : ''}>Add to cart</button></form></div></article></c:forEach></div>
<c:if test="${empty products}"><div class="empty"><h2>No products found</h2><p>Try another search term.</p></div></c:if></main><%@ include file="fragments/footer.jsp" %></body></html>
