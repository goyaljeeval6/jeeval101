<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Checkout | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="auth-wrap"><form class="auth-card" method="post" action="${pageContext.request.contextPath}/checkout"><p class="eyebrow">ALMOST YOURS</p><h1>Checkout.</h1><p class="muted">This student project uses a simulated payment. No real money will be charged.</p><c:if test="${not empty error}"><div class="alert error">${error}</div></c:if><p>On placing the order, stock will be checked and the order will be saved in the database.</p><button class="button full">Place order · Mock payment</button><a href="${pageContext.request.contextPath}/cart">Back to cart</a></form></main><%@ include file="fragments/footer.jsp" %></body></html>
