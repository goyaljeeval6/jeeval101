<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Create account | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jsp" %><main class="auth-wrap"><form class="auth-card" method="post" action="${pageContext.request.contextPath}/register"><p class="eyebrow">JOIN THE COMMUNITY</p><h1>Create account.</h1><c:if test="${not empty error}"><div class="alert error">${error}</div></c:if><label>Full name<input name="name" required maxlength="100"></label><label>Email address<input type="email" name="email" required></label><label>Mobile number <span class="muted">(optional)</span><input name="mobile" maxlength="20"></label><label>Password<input type="password" name="password" minlength="8" required><small>At least 8 characters.</small></label><button class="button full">Create account</button><p class="muted">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></form></main><%@ include file="fragments/footer.jsp" %></body></html>
